<UserControl x:Class="ToolsAndTomes.App.RestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A" Foreground="#E2E8F0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TxtTitle" DockPanel.Dock="Left" FontSize="19" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Withdraw (keep samples)" Padding="12,6" Margin="0,0,8,0" Background="#7F1D1D" Foreground="White" Click="BtnWithdraw_Click"/>
                <Button x:Name="BtnContinue" Content="Continue to next encounter ▶" Padding="14,6" FontWeight="Bold" Background="#0284C7" Foreground="White" Click="BtnContinue_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TxtStatus" FontFamily="Consolas" FontSize="13" Foreground="#F8FAFC"/>
                <TextBlock x:Name="TxtNext" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ComboBox x:Name="CmbCrest" DockPanel.Dock="Right" MinWidth="170" Foreground="Black" SelectionChanged="CmbCrest_SelectionChanged"
                                  ToolTip="Which Crest in the lance to repair, summon, or shape for (each uses its own Motes and fast-iron)"/>
                        <TextBlock Text="Components (Damage Order)" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnRepair" Content="Repair selected (1 fast-iron)" Padding="10,5" Background="#0F766E" Foreground="White" Click="BtnRepair_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LstComponents" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" FontSize="12"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Rest Actions" FontSize="15" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,8"
                                   Text="Rest time passes one Mote at a time. Square Summon, repairs, and shaping happen between Motes and cost no extra time."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="BtnWait" Padding="10,5" Margin="0,0,6,0" Background="#334155" Foreground="White" Click="BtnWait_Click"/>
                            <Button x:Name="BtnWaitAll" Content="Wait out the rest" Padding="10,5" Margin="0,0,6,0" Background="#334155" Foreground="White" Click="BtnWaitAll_Click"/>
                            <Button x:Name="BtnSummon" Padding="10,5" Background="#6D28D9" Foreground="White" Click="BtnSummon_Click"/>
                        </StackPanel>
                        <TextBlock Text="Shape fast-iron / use cargo:" Foreground="#FBBF24" FontSize="11.5" Margin="0,6,0,4"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Do it" Padding="10,4" Margin="6,0,0,0" Background="#B45309" Foreground="White" Click="BtnField_Click"/>
                            <ComboBox x:Name="CmbField" Foreground="Black" DropDownOpened="CmbField_DropDownOpened"/>
                        </DockPanel>
                        <TextBlock Text="Rest log" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4,0,4"/>
                    </StackPanel>
                    <ListBox x:Name="LstLog" Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155" FontSize="11"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="TxtMessage" Margin="0,10,0,0" Foreground="#FACC15" FontSize="12"/>
    </Grid>
</UserControl>
