<UserControl x:Class="ToolsAndTomes.App.MissionSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A" Foreground="#E2E8F0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="TOOLS AND TOMES — MISSION SELECT" FontSize="19" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCrest" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#94A3B8"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="← Back to Crest Bay" Padding="12,6"
                    Background="#475569" Foreground="White" Click="BtnBack_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="6" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,10"
                           Text="A mission is several encounters in a row. Damage, ammo, cargo, Motes, and fast-iron carry through; between fights you rest in the field for a limited time to gather Motes, summon fast-iron, repair, and shape. Samples are kept as you win each fight, even if the mission later fails. Missions unlock through research."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MissionsPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
