<UserControl x:Class="ToolsAndTomes.App.CombatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1120" Foreground="#E2E8F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="135"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Control & Resource Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="BtnPauseToggle" Content="▶ RESUME (Space)" Padding="12,5" FontWeight="Bold" Background="#0284C7" Foreground="White" Margin="0,0,8,0" Click="BtnPauseToggle_Click"/>
                <Button x:Name="BtnStepTick" Content="Step +1 beat" Padding="10,5" Background="#334155" Foreground="White" Margin="0,0,14,0" Click="BtnStepTick_Click"/>
                <TextBlock x:Name="TxtClock" Text="0.00s | PAUSED" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Foreground="#38BDF8" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtPlayerResources" Text="Wit: -- | Motes: -- | Heat: --" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12.5" Foreground="#F8FAFC"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtOutcome" Text="" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#FACC15" Margin="0,0,14,0"/>
                <Button Content="Return to Hangar" Padding="12,5" Background="#475569" Foreground="White" Click="BtnReturnHangar_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Battlefield + Right Inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*"/>
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <!-- Battlefield Canvas -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="6" Margin="0,0,10,0">
                <Grid>
                    <Canvas x:Name="ArenaCanvas" Background="Transparent"
                            MouseLeftButtonDown="ArenaCanvas_MouseLeftButtonDown"
                            MouseRightButtonDown="ArenaCanvas_MouseRightButtonDown"
                            SizeChanged="ArenaCanvas_SizeChanged"/>
                    <TextBlock x:Name="TxtCanvasHint"
                               Text="Left-Click: Select unit / Confirm point target  |  Right-Click: Move Crest  |  Space: Pause/Resume"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,0,0,6"
                               FontSize="11" Foreground="#94A3B8" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Inspector & Combat Log -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*"/>
                    <RowDefinition Height="1.0*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="TxtInspectorTitle" Text="Inspector" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,4"/>
                        <TextBlock DockPanel.Dock="Top" x:Name="TxtInspectorStats" FontFamily="Consolas" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="TxtTargetedCompHint" Text="Damage Order: penetrating damage hits the first operational component." FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        <ListBox x:Name="LstInspectorComponents" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" FontSize="11"
                                 />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="#1E293B" CornerRadius="6" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Combat Event Log" FontWeight="Bold" FontSize="13" Foreground="#F59E0B" Margin="0,0,0,4"/>
                        <ListBox x:Name="LstCombatLog" Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155" FontFamily="Consolas" FontSize="10.5"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Live Tactical Timeline -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="8" Margin="0,8,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="TACTICAL TIMELINE (Blue = Player | Orange = Enemy Windup | Red = Executing | Purple = Recovery | [INT] = Interruptible)"
                           FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TimelinePanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Action Bar -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="6" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="TxtActionStatus" Text="Select a target and choose an operational weapon, defense, or spell:"
                           FontSize="11.5" Foreground="#38BDF8" Margin="0,0,0,6"/>
                <WrapPanel x:Name="ActionBarPanel"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
