<UserControl x:Class="ToolsAndTomes.App.HangarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A" Foreground="#E2E8F0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="TOOLS AND TOMES — CREST BAY" FontSize="19" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbAssemblies" Width="210" Margin="18,0,8,0" VerticalContentAlignment="Center"
                          Foreground="Black" SelectionChanged="CmbAssemblies_SelectionChanged"/>
                <TextBox x:Name="TxtAssemblyName" Width="165" VerticalContentAlignment="Center" Margin="0,0,6,0"
                         Background="#1E293B" Foreground="White" BorderBrush="#475569"/>
                <Button Content="Rename" Padding="9,5" Margin="0,0,6,0" Click="BtnRename_Click"/>
                <Button Content="Save As New" Padding="9,5" Click="BtnSaveNew_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#94A3B8"/>
                <TextBox x:Name="TxtSeed" Width="64" Text="1337" VerticalContentAlignment="Center" Margin="0,0,10,0"
                         Background="#1E293B" Foreground="White" BorderBrush="#475569"/>
                <Button Content="Reset Progress" Padding="9,6" Margin="0,0,8,0" Background="#7F1D1D" Foreground="White" Click="BtnResetProgress_Click"/>
                <Button Content="Research Desk" Padding="11,6" Margin="0,0,8,0" Background="#BE185D" Foreground="White" Click="BtnResearch_Click"/>
                <Button Content="Repair &amp; Refill All" Padding="11,6" Margin="0,0,8,0" Background="#0F766E" Foreground="White" Click="BtnRepairAll_Click"/>
                <Button x:Name="BtnLaunch" Content="MISSION SELECT ▶" Padding="14,6" FontWeight="Bold" Background="#0284C7" Foreground="White" Click="BtnLaunch_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Main 3-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <!-- Installed Components -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock DockPanel.Dock="Top" x:Name="TxtInstalledHeader" Text="Installed Components" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                        <TextBlock Text="Listed in Damage Order: penetrating damage hits the first operational component, then flows down the list." TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtWarnings" TextWrapping="Wrap" Foreground="#FBBF24" FontSize="11.5" Margin="0,0,0,6"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="▲ Earlier" Padding="10,5" Margin="0,0,6,0" Click="BtnMoveUp_Click"/>
                            <Button Content="▼ Later" Padding="10,5" Click="BtnMoveDown_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Uninstall to Spares" Padding="10,5" Margin="0,0,8,0" Click="BtnUninstall_Click"/>
                            <Button Content="Repair Selected" Padding="10,5" Click="BtnRepairSelected_Click"/>
                        </StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Transfer →" Padding="10,4" Margin="6,0,0,0" Click="BtnTransfer_Click"/>
                            <ComboBox x:Name="CmbTransferTarget" Foreground="Black"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox x:Name="LstInstalled" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155"/>
                </DockPanel>
            </Border>

            <!-- Spare Parts & Fabrication -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Spare Components (fabricate known blueprints)" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="Install Selected Spare" Padding="10,5" Margin="0,0,0,8" Click="BtnInstallSpare_Click"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ Fabricate (fast-iron)" Padding="10,4" Margin="6,0,0,0" Click="BtnFabricate_Click"/>
                            <ComboBox x:Name="CmbCatalog" Background="#0F172A" Foreground="Black"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox x:Name="LstSpares" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155"/>
                </DockPanel>
            </Border>

            <!-- Emergent Crest Capabilities -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Emergent Capabilities (Component-Derived)" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                        <TextBlock Text="A Crest has no fixed chassis. Speed, protection, Wit capacity, Mote rate, heat headroom, and actions all emerge from its installed components."
                                   TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtStatsSummary" FontFamily="Consolas" FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                        <Separator Margin="0,12,0,12" Background="#334155"/>
                        <TextBlock Text="Operational Combat Actions" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtActionsSummary" FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                        <Separator Margin="0,12,0,12" Background="#334155"/>
                        <TextBlock Text="Reaction Rules (checked in order during incoming impacts)" FontSize="13" FontWeight="Bold" Foreground="#F472B6" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ListBox x:Name="LstReactionRules" Height="90" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" FontSize="11.5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="▲" Padding="8,3" Margin="0,0,4,0" Click="BtnRuleUp_Click"/>
                            <Button Content="▼" Padding="8,3" Margin="0,0,4,0" Click="BtnRuleDown_Click"/>
                            <Button Content="Remove Rule" Padding="8,3" Click="BtnRuleRemove_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox x:Name="CmbRuleAction" Width="130" Foreground="Black" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CmbRuleTelegraph" Width="110" Foreground="Black" Margin="0,0,4,0"/>
                            <TextBlock Text="≥" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBox x:Name="TxtRuleMinDamage" Width="28" Text="1" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#475569" Margin="0,0,4,0"/>
                            <Button Content="+ Rule" Padding="8,3" Click="BtnRuleAdd_Click"/>
                        </StackPanel>
                        <Separator Margin="0,12,0,12" Background="#334155"/>
                        <TextBlock x:Name="TxtCargoHeader" Text="Cargo (restocked from the Workshop before each fight)" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ListBox x:Name="LstCargo" Height="70" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" FontSize="11.5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox x:Name="CmbCargoItem" Width="150" Foreground="Black" Margin="0,0,4,0"/>
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBox x:Name="TxtCargoCount" Width="28" Text="1" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#475569" Margin="0,0,4,0"/>
                            <Button Content="+ Load" Padding="8,3" Margin="0,0,4,0" Click="BtnCargoAdd_Click"/>
                            <Button Content="Unload" Padding="8,3" Click="BtnCargoRemove_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer hint -->
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="#94A3B8" FontSize="11.5"
                   Text="Tip: Swap Cores, Legs, Armor, Weapons, or Defenses freely between assemblies. Order components so expendable parts absorb damage first; keep the Core last."/>
    </Grid>
</UserControl>
